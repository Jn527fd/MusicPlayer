<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicPlayer" Width="850" Height="560"
        MinWidth="790" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#171B24" Foreground="#E9EDF5">

    <Window.Resources>
        <!-- Reusable rounded buttons for the playback bar -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#2D3545"/>
            <Setter Property="Foreground" Value="#E9EDF5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button"
               BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="#397FBD"/>
        </Style>

        <!-- Dark playlist rows -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Foreground" Value="#E9EDF5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="3,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#303A4C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#335A7F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: familiar menu and right-aligned search -->
        <Border Grid.Row="0" Background="#232B38"
                BorderBrush="#3A4656" BorderThickness="0,0,0,1">
            <Grid Height="48" Margin="10,0,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="Transparent"
                      Foreground="#E9EDF5" VerticalAlignment="Center">
                    <Menu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Background" Value="#232B38"/>
                            <Setter Property="Foreground" Value="#E9EDF5"/>
                            <Setter Property="Padding" Value="12,7"/>
                        </Style>
                    </Menu.Resources>

                    <MenuItem Header="_File">
                        <MenuItem Header="Open File..." Click="OpenFile_Click"/>
                        <MenuItem Header="Open Folder..." Click="OpenFolder_Click"/>
                        <Separator/>
                        <MenuItem Header="Set Default Folder..." Click="SetDefaultFolder_Click"/>
                        <MenuItem Header="Clear Default Folder" Click="ClearDefaultFolder_Click"/>
                    </MenuItem>

                    <MenuItem Header="_Sound">
                        <MenuItem Header="Equalizer..." Click="Equalizer_Click"/>
                        <Separator/>
                        <MenuItem Header="Presets (coming later)" IsEnabled="False"/>
                        <MenuItem Header="Save Custom Preset..." IsEnabled="False"/>
                        <MenuItem Header="Manage Presets..." IsEnabled="False"/>
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="About MusicPlayer" Click="About_Click"/>
                    </MenuItem>
                </Menu>

                <Border Grid.Column="1" Height="32"
                        Background="#151B25" BorderBrush="#526079"
                        BorderThickness="1" CornerRadius="6"
                        VerticalAlignment="Center">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="15" Height="15"
                              Stretch="Uniform" Stroke="#9CA9BD"
                              StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M12,3 A8,8 0 1 1 11.99,3 M18,18 L23,23"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="White" CaretBrush="White"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchHint" Text="Search songs..."
                                       Foreground="#8E9AAB" FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CENTER: current folder and searchable playlist -->
        <Grid Grid.Row="1" Margin="20,18,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="FolderText" Grid.Row="0"
                       Text="No music folder selected"
                       FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="CountText" Grid.Row="1"
                       Text="0 songs" Foreground="#9EADBF"
                       Margin="0,7,0,12"/>

            <ListBox x:Name="SongList" Grid.Row="2"
                     Background="#1D2430" Foreground="#E9EDF5"
                     BorderBrush="#38465A" BorderThickness="1"
                     Padding="5" FontSize="14"
                     DisplayMemberPath="Name"
                     SelectionChanged="SongList_SelectionChanged"
                     MouseDoubleClick="SongList_MouseDoubleClick"/>
        </Grid>

        <!-- BOTTOM: shuffle, repeat, stop, previous, play/pause, next, volume -->
        <Border Grid.Row="2" Background="#232B38" Padding="18,12,18,14"
                BorderBrush="#3A4656" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NowPlayingText" Text="No song selected"
                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1"
                               Text="Open a file or folder to begin"
                               Foreground="#9EADBF" Margin="14,0,0,0"
                               FontSize="12"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="ShuffleButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Shuffle: Off" Click="Shuffle_Click">
                            <Path Width="21" Height="21" Stretch="Uniform"
                                  Stroke="#F0F5FA" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3,7 L6,7 C10,7 13,17 17,17 L21,17 M17,13 L21,17 L17,21 M3,17 L6,17 C10,17 13,7 17,7 L21,7 M17,3 L21,7 L17,11"/>
                        </Button>

                        <Button x:Name="RepeatButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Repeat current song: Off" Click="Repeat_Click">
                            <Path Width="21" Height="21" Stretch="Uniform"
                                  Stroke="#F0F5FA" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5,9 C5,6 7,5 10,5 L19,5 M16,2 L19,5 L16,8 M19,15 C19,18 17,19 14,19 L5,19 M8,16 L5,19 L8,22"/>
                        </Button>

                        <Button x:Name="StopButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Stop" Click="Stop_Click" IsEnabled="False">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="#F0F5FA" Data="M4,4 L20,4 L20,20 L4,20 Z"/>
                        </Button>

                        <Button x:Name="PreviousButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Previous song" Click="Previous_Click" IsEnabled="False">
                            <Path Width="22" Height="22" Stretch="Uniform"
                                  Fill="#F0F5FA"
                                  Data="M4,5 L6,5 L6,19 L4,19 Z M19,5 L8,12 L19,19 Z"/>
                        </Button>

                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButtonStyle}"
                                ToolTip="Play" Click="PlayPause_Click" IsEnabled="False">
                            <Path x:Name="PlayPauseIcon" Width="25" Height="25"
                                  Stretch="Uniform" Fill="White"
                                  Data="M8,5 L20,12 L8,19 Z"/>
                        </Button>

                        <Button x:Name="NextButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Next song" Click="Next_Click" IsEnabled="False">
                            <Path Width="22" Height="22" Stretch="Uniform"
                                  Fill="#F0F5FA"
                                  Data="M18,5 L20,5 L20,19 L18,19 Z M5,5 L16,12 L5,19 Z"/>
                        </Button>
                    </StackPanel>

                    <!-- Volume remains on the right, like a classic player -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Style="{StaticResource TransportButtonStyle}"
                                Width="34" Height="34" Margin="0,0,6,0"
                                ToolTip="Mute" Click="Mute_Click">
                            <Grid Width="23" Height="23">
                                <Path Fill="#F0F5FA"
                                      Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z"/>
                                <Path x:Name="SoundWavePath" Stroke="#F0F5FA"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M15,9 C18,10 18,14 15,15 M17,6 C23,9 23,15 17,18"/>
                            </Grid>
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="110"
                                Minimum="0" Maximum="100" Value="50"
                                VerticalAlignment="Center"
                                ToolTip="Volume"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeText" Text="50%"
                                   Width="38" TextAlignment="Right"
                                   Foreground="#B5C1D0" FontSize="12"
                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
