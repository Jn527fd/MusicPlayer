<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicPlayer" Width="900" Height="860"
        MinWidth="790" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#171B24" Foreground="#E9EDF5">

    <Window.Resources>
        <!-- Reusable rounded buttons for the playback bar -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#2D3545"/>
            <Setter Property="Foreground" Value="#E9EDF5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button"
               BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="#397FBD"/>
        </Style>

        <!-- Dark playlist rows -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#E9EDF5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="3,2">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#303A4C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#335A7F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: familiar menu and right-aligned search -->
        <Border Grid.Row="0" Background="#232B38"
                BorderBrush="#3A4656" BorderThickness="0,0,0,1">
            <Grid Height="48" Margin="10,0,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="Transparent"
                      Foreground="#E9EDF5" VerticalAlignment="Center">
                    <Menu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Background" Value="#232B38"/>
                            <Setter Property="Foreground" Value="#E9EDF5"/>
                            <Setter Property="Padding" Value="12,7"/>
                        </Style>
                    </Menu.Resources>

                    <MenuItem Header="_File">
                        <MenuItem Header="Open File..." Click="OpenFile_Click"/>
                        <MenuItem Header="Open Folder..." Click="OpenFolder_Click"/>
                        <Separator/>
                        <MenuItem Header="Set Default Folder..." Click="SetDefaultFolder_Click"/>
                        <MenuItem Header="Clear Default Folder" Click="ClearDefaultFolder_Click"/>
                    </MenuItem>

                    <MenuItem Header="_Sound">
                        <MenuItem Header="Equalizer..." Click="Equalizer_Click"/>
                        <Separator/>
                        <MenuItem Header="Presets (coming later)" IsEnabled="False"/>
                        <MenuItem Header="Save Custom Preset..." IsEnabled="False"/>
                        <MenuItem Header="Manage Presets..." IsEnabled="False"/>
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="About MusicPlayer" Click="About_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Folder-wide song count, independent of search filtering -->
                <Border Grid.Column="1"
                        Background="#303C4E" BorderBrush="#4A5A70"
                        BorderThickness="1" CornerRadius="4"
                        Padding="12,7" Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="CountText"
                               Text="0 songs in current folder"
                               Foreground="#C7D4E5" FontSize="12"/>
                </Border>

                <Border Grid.Column="2" Height="32"
                        Background="#151B25" BorderBrush="#526079"
                        BorderThickness="1" CornerRadius="6"
                        VerticalAlignment="Center">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="15" Height="15"
                              Stretch="Uniform" Stroke="#9CA9BD"
                              StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M12,3 A8,8 0 1 1 11.99,3 M18,18 L23,23"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="White" CaretBrush="White"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchHint" Text="Search songs..."
                                       Foreground="#8E9AAB" FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CENTER: equal-height now-playing and music-library panels -->
        <Grid Grid.Row="1" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- UPPER HALF: now playing and audio waveform -->
            <Border x:Name="NowPlayingPanel"
                    Grid.Row="0" 
                    Background="#202A38"
                    BorderBrush="#465671" 
                    BorderThickness="1"
                    CornerRadius="8" 
                    Margin="20,8,20,5" 
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header / song information / waveform -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Now Playing"
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <!--current song info -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- album artwork -->
                        <Border Grid.Column="0"
                                Width="68"
                                Height="68"
                                Background="#34435B"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="No Art"
                                           Foreground="#AABBD0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Image Source="{Binding Artwork}"
                                       Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- song info -->
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            
                            <!-- song name -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            
                            <!-- BPM and duration -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,6,0,0">
                                
                                <TextBlock Text="BPM: "
                                           Foreground="#AABBD0"/>
                                
                                <TextBlock Text="{Binding BpmText}"
                                           Foreground="White"/>
                                
                                <TextBlock Text="       Duration: "
                                           Foreground="#AABBD0"/>
                                
                                <TextBlock Text="{Binding LengthText}"
                                           Foreground="White"/>
                            </StackPanel>

                            <!-- technical audio info -->
                            <TextBlock Text="{Binding AudioDetails}"
                                       Foreground="#93A4BB"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis"/>

                        </StackPanel>
                    </Grid>

                    <!-- Step 3: render the entire song's amplitude envelope. -->
                    <Border Grid.Row="2"
                            Background="#162130"
                            CornerRadius="6"
                            Margin="0,8,0,0"
                            Padding="6"
                            MinHeight="48">
                        <Grid>
                            <!-- The Path draws the static waveform; only the Line moves. -->
                            <Canvas x:Name="WaveformCanvas"
                                    ClipToBounds="True"
                                    SizeChanged="WaveformCanvas_SizeChanged">
                                <Path x:Name="WaveformPath"
                                      Fill="#65B7ED"/>
                                <Line x:Name="WaveformPlayhead"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Canvas>

                            <TextBlock x:Name="WaveformStatus"
                                       Text="Select a song to view its waveform"
                                       Foreground="#93A4BB"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
               
                    <Border Grid.Row="3"
                            Background="#162130"
                            CornerRadius="6"
                            Margin="0,8,0,0"
                            Padding="8">
                        
                        <StackPanel>
                            <!-- frquency band indicators -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- bass -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <DockPanel>
                                        <TextBlock Text="Bass"
                                                Foreground="#B5C1D0"/>
                                        <TextBlock x:Name="BassText"
                                                Text="0%"
                                                Foreground="White"
                                                HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <ProgressBar x:Name="BassBar"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                Height="8"
                                                Margin="0,5,0,0"
                                                Foreground="#65B7ED"
                                                Background="#384A61"
                                                BorderThickness="0"/>
                                </StackPanel>

                                <!-- midrange -->
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <DockPanel>
                                        <TextBlock Text="Midrange"
                                                Foreground="#B5C1D0"/>
                                        <TextBlock x:Name="MidText"
                                                Text="0%"
                                                Foreground="White"
                                                HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <ProgressBar x:Name="MidBar"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                Height="8"
                                                Margin="0,5,0,0"
                                                Foreground="#65B7ED"
                                                Background="#384A61"
                                                BorderThickness="0"/>
                                </StackPanel>

                                <!-- treble -->
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Treble"
                                                Foreground="#B5C1D0"/>
                                        <TextBlock x:Name="TrebleText"
                                                Text="0%"
                                                Foreground="White"
                                                HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <ProgressBar x:Name="TrebleBar"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                Height="8"
                                                Margin="0,5,0,0"
                                                Foreground="#65B7ED"
                                                Background="#384A61"
                                                BorderThickness="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- loudness measurements -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">
                                    <TextBlock Text="RMS: "
                                            Foreground="#AABBD0"/>
                                    <TextBlock x:Name="RmsText"
                                            Text="—"
                                            Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <TextBlock Text="Peak: "
                                            Foreground="#AABBD0"/>
                                    <TextBlock x:Name="PeakText"
                                            Text="—"
                                            Foreground="White"/>
                                </StackPanel>
                            </Grid>

                            <!-- background analysis status -->
                            <TextBlock x:Name="AnalysisStatus"
                                    Text="Select a song to analyze"
                                    Foreground="#93A4BB"
                                    FontSize="11"
                                    Margin="0,4,0,0"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <!-- LOWER HALF: header stays still; ListBox scrolls independently -->
            <Border Grid.Row="1" Margin="20,6,20,14"
                    Background="#1D2430" BorderBrush="#38465A"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Fixed headers, inside the same border as the songs -->
                    <Grid Grid.Row="0" Margin="16,10,34,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Image" Foreground="#AABBC9"/>
                        <TextBlock Grid.Column="1" Text="Song Name" Foreground="#AABBC9"/>
                        <TextBlock Grid.Column="2" Text="BPM" Foreground="#AABBC9"
                                   TextAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Length" Foreground="#AABBC9"
                                   TextAlignment="Center"/>
                    </Grid>

                    <!-- Only this ListBox scrolls; the header above it stays visible -->
                    <ListBox x:Name="SongList" Grid.Row="1"
                             Background="Transparent" Foreground="#E9EDF5"
                             BorderThickness="0" Padding="5" FontSize="14"
                             SelectionChanged="SongList_SelectionChanged"
                             MouseDoubleClick="SongList_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Individual song card -->
                                <Border BorderBrush="#43516A" BorderThickness="1"
                                        Background="Transparent" CornerRadius="6"
                                        Padding="8" Margin="2,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Width="55" Height="55"
                                                Padding="0" Background="#414D60"
                                                BorderThickness="0" Cursor="Hand"
                                                ToolTip="Change album artwork"
                                                Tag="{Binding}" Click="Artwork_Click">
                                            <Grid>
                                                <TextBlock Text="+ Art" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Image Source="{Binding Artwork}"
                                                       Stretch="UniformToFill"/>
                                            </Grid>
                                        </Button>

                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BpmText}"
                                                   Foreground="#B5C1D0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LengthText}"
                                                   Foreground="#B5C1D0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM: song title, seek bar and transport controls -->
        <Border Grid.Row="2" Background="#232B38" Padding="18,12,18,14"
                BorderBrush="#3A4656" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Song title -->
                <TextBlock x:Name="NowPlayingText" Grid.Row="0"
                           Text="No song selected"
                           TextTrimming="CharacterEllipsis"
                           FontWeight="SemiBold" Margin="2,0,2,10"/>

                <!-- Seek: elapsed time | slider | total duration -->
                <Grid Grid.Row="1" Margin="2,0,2,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ElapsedTimeText" Grid.Column="0"
                               Text="0:00" Foreground="#B5C1D0"
                               FontSize="12" VerticalAlignment="Center"/>

                    <Slider x:Name="SeekSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0"
                            IsEnabled="False"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            ToolTip="Seek to position"
                            ValueChanged="SeekSlider_ValueChanged"/>

                    <TextBlock x:Name="DurationText" Grid.Column="2"
                               Text="0:00" Foreground="#B5C1D0"
                               FontSize="12" TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Centered playback, volume and mute controls -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="ShuffleButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Shuffle: Off" Click="Shuffle_Click">
                            <Path Width="21" Height="21" Stretch="Uniform"
                                  Stroke="#F0F5FA" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3,7 L6,7 C10,7 13,17 17,17 L21,17 M17,13 L21,17 L17,21 M3,17 L6,17 C10,17 13,7 17,7 L21,7 M17,3 L21,7 L17,11"/>
                        </Button>

                        <Button x:Name="RepeatButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Repeat current song: Off" Click="Repeat_Click">
                            <Path Width="21" Height="21" Stretch="Uniform"
                                  Stroke="#F0F5FA" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5,9 C5,6 7,5 10,5 L19,5 M16,2 L19,5 L16,8 M19,15 C19,18 17,19 14,19 L5,19 M8,16 L5,19 L8,22"/>
                        </Button>

                        <!-- Separator: shuffle/repeat | playback -->
                        <Border Width="1" Height="26"
                                Background="#64748B" Margin="12,0"
                                VerticalAlignment="Center"/>

                        <Button x:Name="PreviousButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Previous song" Click="Previous_Click" IsEnabled="False">
                            <Path Width="22" Height="22" Stretch="Uniform"
                                  Fill="#F0F5FA"
                                  Data="M4,5 L6,5 L6,19 L4,19 Z M19,5 L8,12 L19,19 Z"/>
                        </Button>

                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButtonStyle}"
                                ToolTip="Play" Click="PlayPause_Click" IsEnabled="False">
                            <Path x:Name="PlayPauseIcon" Width="25" Height="25"
                                  Stretch="Uniform" Fill="White"
                                  Data="M8,5 L20,12 L8,19 Z"/>
                        </Button>

                        <Button x:Name="NextButton" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="Next song" Click="Next_Click" IsEnabled="False">
                            <Path Width="22" Height="22" Stretch="Uniform"
                                  Fill="#F0F5FA"
                                  Data="M18,5 L20,5 L20,19 L18,19 Z M5,5 L16,12 L5,19 Z"/>
                        </Button>

                        <!-- Separator: playback | volume -->
                        <Border Width="1" Height="26"
                                Background="#64748B" Margin="12,0"
                                VerticalAlignment="Center"/>

                        <!-- Volume next to playback buttons -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Style="{StaticResource TransportButtonStyle}"
                                Width="34" Height="34" Margin="0,0,6,0"
                                ToolTip="Mute" Click="Mute_Click">
                            <Grid Width="23" Height="23">
                                <Path Fill="#F0F5FA"
                                      Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z"/>
                                <Path x:Name="SoundWavePath" Stroke="#F0F5FA"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M15,9 C18,10 18,14 15,15 M17,6 C23,9 23,15 17,18"/>
                            </Grid>
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="110"
                                Minimum="0" Maximum="100" Value="100"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                ToolTip="Volume"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeText" Text="100%"
                                   Width="38" TextAlignment="Right"
                                   Foreground="#B5C1D0" FontSize="12"
                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
