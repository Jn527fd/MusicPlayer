<Window x:Class="MusicPlayer.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Equalizer"
        Width="440"
        Height="380"
        MinWidth="400"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="#171C26"
        Foreground="White">

    <StackPanel Margin="24">

        <TextBlock Text="Audio Equalizer"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <CheckBox x:Name="EnableEqCheck"
                  Content="Enable Equalizer"
                  Foreground="White"
                  IsChecked="True"
                  Checked="EqEnabledChanged"
                  Unchecked="EqEnabledChanged"
                  Margin="0,0,0,20"/>

        <!-- Bass -->
        <TextBlock Text="Bass — 100 Hz"
                   Foreground="#AABBD0"/>

        <Slider x:Name="BassSlider"
                Minimum="-9"
                Maximum="9"
                Value="0"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                ValueChanged="EqSliderChanged"
                Margin="0,8,0,3"/>

        <TextBlock x:Name="BassValue"
                   Foreground="White"
                   HorizontalAlignment="Right"
                   Margin="0,0,0,14"/>

        <!-- Midrange -->
        <TextBlock Text="Midrange — 1 kHz"
                   Foreground="#AABBD0"/>

        <Slider x:Name="MidSlider"
                Minimum="-9"
                Maximum="9"
                Value="0"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                ValueChanged="EqSliderChanged"
                Margin="0,8,0,3"/>

        <TextBlock x:Name="MidValue"
                   Foreground="White"
                   HorizontalAlignment="Right"
                   Margin="0,0,0,14"/>

        <!-- Treble -->
        <TextBlock Text="Treble — 10 kHz"
                   Foreground="#AABBD0"/>

        <Slider x:Name="TrebleSlider"
                Minimum="-9"
                Maximum="9"
                Value="0"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                ValueChanged="EqSliderChanged"
                Margin="0,8,0,3"/>

        <TextBlock x:Name="TrebleValue"
                   Foreground="White"
                   HorizontalAlignment="Right"
                   Margin="0,0,0,16"/>

        <Button Content="Reset to Flat"
                Click="ResetEq_Click"
                Background="#34435B"
                Foreground="White"
                Padding="12,8"
                HorizontalAlignment="Right"/>

    </StackPanel>
</Window>
