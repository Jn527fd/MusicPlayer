<Window x:Class="MusicPlayer.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graphic Equalizer"
        Width="760" Height="420"
        MinWidth="700" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#1B2330" Foreground="White">

    <Window.Resources>
        <!-- CHANGE 1: Keep the custom vertical slider artwork from the 10-band EQ.
             PART_Track is required for Slider to handle dragging and keyboard input. -->
        <Style x:Key="EqSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="-12"/>
            <Setter Property="Maximum" Value="12"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="IsDirectionReversed" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="26" HorizontalAlignment="Center">
                            <!-- Draw the vertical track behind the draggable thumb. -->
                            <Rectangle Width="2" Fill="#58708B"
                                       Margin="0,7" HorizontalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="9">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#70C5F5"
                                                        CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHANGE 2: Dark dropdown ITEMS. The default Windows ComboBoxItem
             can show white on white; this sets colors for normal/hover/selected. -->
        <Style x:Key="DarkPresetItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#253244"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background" Value="#355577"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background" Value="#31516F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHANGE 3: Dark dropdown BOX + popup, not just its items.
             Keeping PART_Popup and ItemsPresenter preserves selection behavior. -->
        <Style x:Key="DarkPresetComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#253244"/>
            <Setter Property="BorderBrush" Value="#465671"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkPresetItemStyle}"/>
            <Setter Property="MaxDropDownHeight" Value="250"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Entire closed control opens the menu when clicked. -->
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#253244"
                                                BorderBrush="#465671"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <ContentPresenter
                                                    Content="{Binding SelectionBoxItem,
                                                        RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    Margin="12,0,32,0"
                                                    VerticalAlignment="Center"
                                                    TextElement.Foreground="White"
                                                    IsHitTestVisible="False"/>
                                                
                                                <Path Data="M 0,0 L 5,5 L 10,0"
                                                        Stroke="#B5C8DC"
                                                        StrokeThickness="1.5"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        Width="10"
                                                        Height="5"
                                                        Stretch="None"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0"
                                                        IsHitTestVisible="False"/>

                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Popup uses the same palette as the File menu. -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#253244"
                                        BorderBrush="#465671"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <!-- CHANGE 4: Five content rows with NO row for an Enabled checkbox. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title -->
            <RowDefinition Height="Auto"/>  <!-- Preset and Reset -->
            <RowDefinition Height="Auto"/>  <!-- Gain labels -->
            <RowDefinition Height="*"/>     <!-- Ten sliders -->
            <RowDefinition Height="Auto"/>  <!-- Frequency footer -->
        </Grid.RowDefinitions>

        <!-- CHANGE 5: Title only. Removed subtitle and Enabled checkbox. -->
        <TextBlock Grid.Row="0"
                   Text="Graphic Equalizer"
                   FontSize="19"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- CHANGE 6: The preset list is now a dark themed dropdown. -->
            <ComboBox x:Name="PresetBox"
                      Grid.Column="0"
                      Style="{StaticResource DarkPresetComboBoxStyle}"
                      Height="32"
                      SelectionChanged="PresetChanged"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="Custom"/>
                <ComboBoxItem Content="Flat"/>
                <ComboBoxItem Content="Bass Boost"/>
                <ComboBoxItem Content="Vocal"/>
                <ComboBoxItem Content="V-Shape"/>
            </ComboBox>

            <!-- Reset is still handled by ResetEq_Click in the code-behind.
                 That method should set all 10 gains to 0 and select Flat. -->
            <Button Grid.Column="1"
                    Content="Reset"
                    Click="ResetEq_Click"
                    Background="#253244"
                    Foreground="White"
                    BorderBrush="#465671"
                    Padding="16,6"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="+12 dB" FontSize="10"
                       Foreground="#9EB3CD" HorizontalAlignment="Left"/>
            <TextBlock Text="GAIN" FontSize="10"
                       Foreground="#9EB3CD" HorizontalAlignment="Right"/>
        </Grid>

        <!-- CHANGE 7: Same 10-band layout. EqualizerWindow.xaml.cs adds
             the frequency cards / vertical sliders to BandsPanel at runtime. -->
        <UniformGrid x:Name="BandsPanel" Grid.Row="3"
                     Columns="10" Rows="1"/>

        <TextBlock Grid.Row="4"
                   Text="Frequency bands — Hz"
                   FontSize="11"
                   Foreground="#91A8C4"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>
